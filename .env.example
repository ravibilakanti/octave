# Copy this file to .env and fill in what you use.
# Never commit .env — it holds personal data and API keys.

DATABASE_URL="file:./dev.db"

# OpenAI-compatible chat API (OpenAI, Azure OpenAI, Groq, Together, Ollama, etc.)
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Auto-apply only when fitment is at or above this score (0–10).
MIN_FIT_SCORE="8"

# If true, jobs that meet MIN_FIT_SCORE are queued and submitted via enabled adapters.
# Keep false until you have reviewed your profile and adapters.
AUTO_APPLY_ENABLED="false"

# Optional: used as the From/reply address on email applications.
APPLY_FROM_EMAIL=""

# SMTP for email applications (optional). Leave blank to skip email apply.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Job search providers — enable at least one. All are optional; you can also paste jobs in.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="us"

# RapidAPI JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=""
JSEARCH_HOST="jsearch.p.rapidapi.com"

# Remotive public remote jobs (no key). Set to "true" to include.
REMOTIVE_ENABLED="true"

# Greenhouse job board tokens, comma-separated (company board slugs).
# Example: stripe,airbnb
GREENHOUSE_BOARDS=""

# App
NEXT_PUBLIC_APP_NAME="Octave"
NEXT_PUBLIC_MIN_FIT_SCORE="8"

MAX_JOBS_TO_ANALYZE_PER_RUN="50"
AUTOMATION_CRON_SECRET=""
