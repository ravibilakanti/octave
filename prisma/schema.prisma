generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String?   @unique
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String    @default("")
  email              String    @default("")
  phone              String?
  location           String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  workAuthorization  String?
  willingToRelocate  Boolean   @default(false)
  remotePreference   String    @default("any")
  salaryMin          Int?
  salaryMax          Int?
  targetTitles       String    @default("[]")
  keywords           String    @default("[]")
  summary            String    @default("")
  rawResume          String    @default("")
  personalNotes      String    @default("")
  autoApply          Boolean   @default(false)
  minFitScore        Float     @default(8)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  experiences        Experience[]
  education          Education[]
  skills             Skill[]
  certifications     Certification[]
  projects           Project[]
  resumeVersions     ResumeVersion[]
  savedSearches      SavedSearch[]
  jobs               Job[]
  automationRuns     AutomationRun[]
}

model Experience {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  title        String
  location     String?
  startDate    String
  endDate      String?
  current      Boolean  @default(false)
  description  String
  achievements String   @default("[]")
  sortOrder    Int      @default(0)
}

model Education {
  id         String  @id @default(cuid())
  profileId  String   @default("me")
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school     String
  degree     String
  field      String?
  startDate  String?
  endDate    String?
  notes      String?
  sortOrder  Int     @default(0)
}

model Skill {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String  @default("core")
  level     String  @default("proficient")
}

model Certification {
  id         String  @id @default(cuid())
  profileId  String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedOn   String?
  expiresOn  String?
  url        String?
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  url         String?
  description String
  highlights  String   @default("[]")
}

model ResumeVersion {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  kind        String   @default("ats")
  title       String
  content     String
  createdAt   DateTime @default(now())
}

model SavedSearch {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  query      String
  location   String   @default("")
  remoteOnly Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Job {
  id             String   @id @default(cuid())
  profileId      String   @default("me")
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  externalId     String
  provider       String
  title          String
  company        String
  location       String?
  remote         Boolean  @default(false)
  url            String?
  applyUrl       String?
  applyEmail     String?
  description    String
  salary         String?
  postedAt       String?
  rawJson         String  @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  analyses       Fitment[]
  applications   Application[]
  resumeVersions ResumeVersion[]

  @@unique([profileId, provider, externalId])
}

model Fitment {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score         Float
  recommendation String   @default("review")
  summary       String
  strengths     String   @default("[]")
  gaps          String     @default("[]")
  keywordHits   String     @default("[]")
  breakdown     String   @default("{}")
  model         String?
  createdAt     DateTime @default(now())
}

model Application {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          String   @default("queued")
  channel         String   @default("packet")
  fitScore        Float?
  resumeText      String   @default("")
  coverLetter     String   @default("")
  notes           String   @default("")
  error           String?
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  events          ApplicationEvent[]
}

model ApplicationEvent {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status         String
  message        String
  createdAt      DateTime    @default(now())
}

model AutomationRun {
  id               String   @id @default(cuid())
  profileId        String   @default("me")
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  trigger          String   @default("manual")
  status           String   @default("running")
  searchesRun      Int      @default(0)
  jobsFound        Int      @default(0)
  jobsAnalyzed     Int      @default(0)
  applicationsSent Int      @default(0)
  packetsReady     Int      @default(0)
  errors           String   @default("[]")
  summary          String   @default("")
}
